# --------------------------------------------------------------------------- #
def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--data-root", type=Path, default=Path("data/aidev-7.6m"))
    ap.add_argument("--output-dir", type=Path, default=Path("results/reproduction"))
    ap.add_argument("--sampling-cap", type=int, default=200)
    ap.add_argument("--seed", type=int, default=2018)
    args = ap.parse_args()

    out_dir: Path = args.output_dir
    out_dir.mkdir(parents=True, exist_ok=True)

    print(">> loading pull_request.parquet", flush=True)
    prs = load_prs(args.data_root)
    print(f"   PRs: {len(prs):,}  repos: {prs['repo_id'].nunique():,}", flush=True)

    # --- strict scope: ordinary PR comments only (matches the original comment table)
    print(">> strict scope: pr_comments only", flush=True)
    cmt_strict, info_strict = load_comments(args.data_root, prs, include_reviews=False)
    rows_strict, counters_strict, unresolved_strict = identify(prs, cmt_strict)
    print(f"   candidate pairs: {len(rows_strict):,}", flush=True)

    # --- extended scope: also review bodies and inline review comments
    print(">> extended scope: pr_comments + pr_reviews + pr_review_comments", flush=True)
    cmt_ext, info_ext = load_comments(args.data_root, prs, include_reviews=True)
    rows_ext, counters_ext, unresolved_ext = identify(prs, cmt_ext)
    print(f"   candidate pairs: {len(rows_ext):,}", flush=True)

    # --- agent labels and repo names for readability
    meta = prs.set_index("id")[["agent", "repo_full_name", "html_url"]]
    for rows in (rows_strict, rows_ext):
        for r in rows:
            r["repo_full_name"] = meta.at[r["master_pr_id"], "repo_full_name"]
            r["master_url"] = meta.at[r["master_pr_id"], "html_url"]
            r["duplicate_url"] = meta.at[r["duplicate_pr_id"], "html_url"]
            r["master_agent"] = meta.at[r["master_pr_id"], "agent"]
            r["duplicate_agent"] = meta.at[r["duplicate_pr_id"], "agent"]
            r["idn_cmt_url"] = f"{r['duplicate_url']}#issuecomment-{r['idn_cmt_id'].split(':')[1]}"

    df_strict = pd.DataFrame(rows_strict)
    df_ext = pd.DataFrame(rows_ext)

    if not df_strict.empty:
        df_strict["same_author"] = df_strict["master_author"] == df_strict["duplicate_author"]
        df_strict["same_agent"] = df_strict["master_agent"] == df_strict["duplicate_agent"]
    if not df_ext.empty:
        df_ext["same_author"] = df_ext["master_author"] == df_ext["duplicate_author"]
        df_ext["same_agent"] = df_ext["master_agent"] == df_ext["duplicate_agent"]

    df_strict.to_csv(out_dir / "candidate_duplicates_strict.csv", index=False, encoding="utf-8-sig")
    df_ext.to_csv(out_dir / "candidate_duplicates_extended.csv", index=False, encoding="utf-8-sig")

    # paper-style Duplicate table
    if not df_strict.empty:
        dup_tbl = df_strict[["repo_id", "master_pr_number", "duplicate_pr_number", "idn_cmt_id",
                             "repo_full_name", "master_url", "duplicate_url", "idn_cmt_body"]].copy()
        dup_tbl.columns = ["prj_id", "mst_pr", "dup_pr", "idn_cmt",
                           "repo_full_name", "master_url", "duplicate_url", "idn_cmt_text"]
        dup_tbl.to_csv(out_dir / "duplicate_table_msr2018_style.csv", index=False, encoding="utf-8-sig")

    # unfiltered pairs (no F1/F2/F3), for follow-up work
    print(">> building unfiltered candidate set", flush=True)
    rows_unf, counters_unf, _ = identify_unfiltered(prs, cmt_strict)
    pd.DataFrame(rows_unf).to_csv(out_dir / "candidate_duplicates_unfiltered.csv",
                                  index=False, encoding="utf-8-sig")

    # unresolved references
    un_res = pd.DataFrame(unresolved_strict)
    if not un_res.empty:
        un_res["repo_full_name"] = un_res["repo_id"].map(prs.set_index("repo_id")["repo_full_name"].to_dict())
    un_res.to_csv(out_dir / "unresolved_references.csv", index=False, encoding="utf-8-sig")

    # sampling replay
    print(">> replaying stage-1 sampling", flush=True)
    sample, sampling_stats = replay_sampling(prs, cmt_strict, args.sampling_cap, args.seed)
    sample_out = sample[["repo_full_name", "pr_id", "comment_id", "author", "created_at",
                         "rule_numbers", "matched_by_rules", "body"]].copy()
    sample_out["body"] = sample_out["body"].str.slice(0, 1000)
    sample_out.to_csv(out_dir / "sampled_comments_for_manual_review.csv", index=False, encoding="utf-8-sig")

    # ---- summaries
    def build_summary(rows, counters, info, cmt):
        closed_after = sum(1 for r in rows if r["duplicate_pr_closed_after_idn"])
        time_ok = sum(1 for r in rows if r["number_order_matches_time_order"])
        filt = {k: v for k, v in counters.items() if k.startswith(("f1_", "f2_", "f3_", "self_"))}
        return {
            "candidate_pairs": len(rows),
            "comments_total": info["comments_total"],
            "comment_loading": {k: v for k, v in info.items()},
            "comments_with_cross_pr_reference": counters.get("comments_with_cross_pr_reference", 0),
            "rule_mentions": counters.get("rule_mentions", 0),
            "resolved_mentions": counters.get("resolved_mentions", 0),
            "unfiltered_unique_pairs": counters.get("unfiltered_unique_pairs", 0),
            "filter_counts": filt,
            "latency": latency_summary(rows),
            "effort": effort_summary(rows),
            "closed_after_idn": closed_after,
            "closed_after_idn_percent": pct(closed_after, len(rows)),
            "time_order_consistent": time_ok,
            "time_order_inconsistent": len(rows) - time_ok,
            "bot_evidence_comments": sum(1 for r in rows if r["idn_cmt_author_is_bot"]),
            "agent_flows": ({str(k): int(v) for k, v in
                             pd.Series([f"{r['master_agent']} -> {r['duplicate_agent']}" for r in rows])
                             .value_counts().items()} if rows else {}),
        }

    n_above = int(un_res["target_above_repo_max_number"].sum()) if not un_res.empty else 0
    n_below = int(len(un_res) - n_above)
    caveats = {
        "input_prs": int(len(prs)),
        "input_repos": int(prs["repo_id"].nunique()),
        "pr_table_is_agentic_subset": True,
        "pr_table_note": ("AIDev-pop pull_request contains only AI-agent-authored PRs from "
                          "repositories with >100 stars, not every PR of those repositories."),
        "agents_present": prs["agent"].value_counts().to_dict(),
        "f1_unresolved_mentions": counters_strict.get("f1_unresolved_target", 0),
        "f1_unresolved_share_percent": pct(counters_strict.get("f1_unresolved_target", 0),
                                           counters_strict.get("rule_mentions", 0)),
        "unresolved_below_repo_max": n_below,
        "unresolved_above_repo_max": n_above,
    }

    summary = {
        "method": "MSR2018 DupPR (Yu et al.) applied to AIDev-pop Parquet data",
        "rules_source": str(HERE / "rules.py"),
        "auto_ident_source": str(HERE / "auto_ident.py"),
        "data_root": str(args.data_root),
        "strict": build_summary(rows_strict, counters_strict, info_strict, cmt_strict),
        "extended": build_summary(rows_ext, counters_ext, info_ext, cmt_ext),
        "unfiltered": counters_unf,
        "sampling_replay": sampling_stats,
        "corpus_caveats": caveats,
        "stage_status": {
            "1_random_sampling": "replayed for rule hit-rate estimation",
            "2_manual_examination": "NOT automated - needs a human",
            "3_rules_extraction": "reused from code/rules.py",
            "4_automatic_identification": "executed on the full corpus",
            "5_manual_verifying": "NOT automated - proxy signals only",
        },
    }
    (out_dir / "summary.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False, default=str),
                                          encoding="utf-8")
    write_report(out_dir / "report.md", summary)

    print(json.dumps({
        "strict_pairs": summary["strict"]["candidate_pairs"],
        "extended_pairs": summary["extended"]["candidate_pairs"],
        "unfiltered_pairs": summary["strict"]["unfiltered_unique_pairs"],
        "f1_unresolved": caveats["f1_unresolved_mentions"],
        "output_dir": str(out_dir),
    }, ensure_ascii=True, indent=2))


def identify_unfiltered(prs: pd.DataFrame, cmt: pd.DataFrame) -> tuple[list[dict], dict, list[dict]]:
    """Same rules and resolution as identify(), but with F1/F2/F3 skipped, so no
    evidence is lost to the filters. F1 cannot be skipped meaningfully (an
    unresolved number gives no PR row to pair with), so it is still applied."""
    by_repo_number: dict[tuple[int, int], int] = {}
    number_of: dict[int, int] = {}
    author_of: dict[int, str] = {}
    repo_of: dict[int, int] = {}
    created_of: dict[int, pd.Timestamp] = {}
    title_of: dict[int, str] = {}
    for r in prs.itertuples(index=False):
        pid = int(r.id)
        by_repo_number[(int(r.repo_id), int(r.number))] = pid
        number_of[pid] = int(r.number)
        author_of[pid] = r.user
        repo_of[pid] = int(r.repo_id)
        created_of[pid] = r.created_at
        title_of[pid] = r.title

    counters: dict[str, int] = defaultdict(int)
    pairs: dict[tuple[int, int], list[dict]] = defaultdict(list)
    ref = cmt[cmt["body"].str.contains(HAS_REF_RE, regex=True, na=False)]
    for r in ref.itertuples(index=False):
        src_id = int(r.pr_id)
        if src_id not in number_of:
            continue
        repo = repo_of[src_id]
        src_num = number_of[src_id]
        for tgt_num in extract_numbers(r.body):
            counters["rule_mentions"] += 1
            tgt_id = by_repo_number.get((repo, tgt_num))
            if tgt_id is None:
                counters["f1_unresolved_target"] += 1
                continue
            if tgt_id == src_id:
                counters["self_reference"] += 1
                continue
            counters["resolved_mentions"] += 1
            dup_num, mst_num = max(src_num, tgt_num), min(src_num, tgt_num)
            dup_id = by_repo_number[(repo, dup_num)]
            mst_id = by_repo_number[(repo, mst_num)]
            pairs[(mst_id, dup_id)].append({
                "comment_id": r.comment_id,
                "comment_created_at": r.created_at,
                "comment_body": r.body,
            })

    rows = []
    for (mst_id, dup_id), ev in sorted(pairs.items()):
        ev.sort(key=lambda x: (pd.isna(x["comment_created_at"]), x["comment_created_at"], x["comment_id"]))
        rows.append({
            "pair_id": f"{number_of[dup_id]}-{number_of[mst_id]}",
            "master_pr_id": mst_id,
            "master_pr_number": number_of[mst_id],
            "duplicate_pr_id": dup_id,
            "duplicate_pr_number": number_of[dup_id],
            "repo_id": repo_of[mst_id],
            "master_title": title_of[mst_id],
            "master_author": author_of[mst_id],
            "duplicate_author": author_of[dup_id],
            "same_author": author_of[mst_id] == author_of[dup_id],
            "master_created_at": created_of[mst_id],
            "duplicate_created_at": created_of[dup_id],
            "evidence_count": len(ev),
            "first_comment_id": ev[0]["comment_id"],
            "first_comment_created_at": ev[0]["comment_created_at"],
            "first_comment_body": ev[0]["comment_body"][:500],
        })
    counters["unique_pairs"] = len(rows)
    return rows, dict(counters), []


if __name__ == "__main__":
    main()
