# coding: utf-8
"""Reproduce the MSR 2018 DupPR method on the local AIDev-pop Parquet tables.

Paper: Yu, Li, Yin, Wang, Wang. "A Dataset of Duplicate Pull-requests in GitHub",
MSR 2018.  https://doi.org/10.1145/3196398.3196455

The paper's collection process (its Figure 1) has five stages:
  1. random sampling of review comments containing a cross-PR reference
  2. manual examination -> indicative comments
  3. rules extraction -> identification rules
  4. automatic identification -> candidate duplicate PRs
  5. manual verifying -> final duplicate PRs

What this script reproduces
---------------------------
Reused unchanged from ``code/``:
  * ``rules.py``      - the published identification rules (stage 3, already done)
  * ``auto_ident.py`` - rule application, PR-number ordering of master/duplicate,
                        and the three preliminary filters:
                          F1 target reference must resolve to a PR (not an issue)
                          F2 the two PRs must have different authors
                          F3 the duplicate author must not already know the master
                             (F3.1 prior comment on the master PR, F3.2 master number
                              appearing in the duplicate PR title/description)

Re-implemented here because the input is Parquet instead of the original MySQL dump:
  * stage 4 over the full corpus (stage 1's sample was only needed to *build* the
    rules, which are already fixed in ``rules.py``); the sampling stage is also
    replayed at the end so the rule hit-rate can be estimated on this corpus
  * two comment scopes: ``pr_comments`` only (strict, matches the original ``comment``
    table) and ``pr_comments + pr_reviews + pr_review_comments`` (broad, because the
    paper says "review comments" without narrowing the GitHub comment kind)
  * paper-style ``Duplicate`` table export (prj_id, mst_pr, dup_pr, idn_cmt)
  * stage 5 cannot be automated: the paper's criteria are human judgements. This
    script instead reports *proxy* signals (was the duplicate PR closed right after
    the identification comment? how many reviewers/comments were spent before
    detection?) and exports a review sheet for a human to label.

Important corpus caveat, reported as ``corpus_caveats`` in summary.json
------------------------------------------------------------------------
AIDev-pop ``pull_request`` holds only *agentic* PRs from repositories with >100
stars. It is not the full PR space of those repositories. The original F1 filter
("number not in the PR table -> it is an issue") therefore over-filters here: a
reference can point at a genuine PR that is simply absent from the table. This
script keeps F1 as published (so the pipeline stays faithful) but counts and
exports every unresolved reference separately instead of hiding it.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from pathlib import Path

import numpy as np
import pandas as pd

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import rules  # noqa: E402  # original MSR2018-DupPR rules, used verbatim

# A comment can reference another PR either as "#123" or as a full pull URL.
HAS_REF_RE = re.compile(r"#\d+|/pull/\d+")
# Pull URLs appear in two shapes:
#   https://github.com/owner/repo/pull/123          (web)
#   https://api.github.com/repos/owner/repo/pulls/123 (API, used by pr_review_comments)
PULL_URL_RE = r"github\.com/(?:repos/)?([^/\s]+/[^/\s]+?)/(?:pull|pulls)/(\d+)"


# --------------------------------------------------------------------------- #
# helpers
# --------------------------------------------------------------------------- #
def to_text(v) -> str:
    if v is None:
        return ""
    try:
        if pd.isna(v):
            return ""
    except (TypeError, ValueError):
        pass
    return str(v)


def clean_series(s: pd.Series) -> pd.Series:
    return s.map(to_text)


def repo_full_name_from_url(url: str) -> str:
    url = to_text(url)
    m = re.search(r"github\.com/([^/\s]+/[^/\s]+?)(?:\.git)?/?$", url)
    if m:
        return m.group(1)
    parts = [p for p in url.split("/") if p]
    return "/".join(parts[-2:]) if len(parts) >= 2 else url


def extract_numbers(body: str) -> list[int]:
    """Exactly ``AutoIdent.extract_num_by_rule``: every rule is searched, then
    every capture group value is collected. Duplicates are kept, as in the
    original code (the pair dictionary collapses them later)."""
    body = to_text(body).lower()
    out: list[int] = []
    for rule in rules.rules:
        if re.search(rule, body) is not None:
            for number in re.findall(rule, body):
                if number:
                    out.append(int(number))
    return out


def pct(part: int, whole: int) -> float:
    return round(100.0 * part / whole, 2) if whole else 0.0


# --------------------------------------------------------------------------- #
# loading
# --------------------------------------------------------------------------- #
def load_prs(root: Path) -> pd.DataFrame:
    prs = pd.read_parquet(root / "pull_request.parquet", columns=[
        "id", "number", "title", "body", "agent", "user", "state",
        "created_at", "closed_at", "merged_at", "repo_id", "repo_url", "html_url",
    ])
    for c in ["id", "number", "repo_id"]:
        prs[c] = prs[c].astype("int64")
    for c in ["title", "body", "agent", "user", "state", "html_url", "repo_url"]:
        prs[c] = clean_series(prs[c])
    for c in ["created_at", "closed_at", "merged_at"]:
        prs[c] = pd.to_datetime(prs[c], utc=True, errors="coerce")
    prs["repo_full_name"] = prs["repo_url"].map(repo_full_name_from_url)
    return prs


def load_comments(root: Path, prs: pd.DataFrame, include_reviews: bool) -> tuple[pd.DataFrame, dict]:
    """Return one normalized comment frame: comment_id, source, pr_id, author,
    author_is_bot, created_at, body."""
    frames = []
    info: dict = {}

    pc = pd.read_parquet(root / "pr_comments.parquet",
                         columns=["id", "pr_id", "user", "user_type", "created_at", "body"])
    pc = pc.rename(columns={"id": "raw_id", "user": "author", "user_type": "author_type"})
    pc["source"] = "pr_comments"
    info["pr_comments_rows"] = int(len(pc))
    frames.append(pc)

    if include_reviews:
        rv = pd.read_parquet(root / "pr_reviews.parquet",
                             columns=["id", "pr_id", "user", "user_type", "submitted_at", "body"])
        rv = rv.rename(columns={"id": "raw_id", "user": "author", "user_type": "author_type",
                                "submitted_at": "created_at"})
        rv["source"] = "pr_reviews"
        info["pr_reviews_rows"] = int(len(rv))
        frames.append(rv)

        # Inline review comments carry no pr_id, only the pull request URL.
        rc = pd.read_parquet(root / "pr_review_comments.parquet",
                             columns=["id", "user", "user_type", "created_at", "body", "pull_request_url"])
        ext = rc["pull_request_url"].astype(str).str.extract(PULL_URL_RE)
        rc["repo_full_name"] = ext[0].fillna("")
        rc["number"] = pd.to_numeric(ext[1], errors="coerce")
        key = prs[["repo_full_name", "number", "id"]].rename(columns={"id": "pr_id"})
        rc = rc.merge(key, on=["repo_full_name", "number"], how="left")
        info["pr_review_comments_rows"] = int(len(rc))
        info["pr_review_comments_url_resolved"] = int(rc["pr_id"].notna().sum())
        rc = rc.rename(columns={"id": "raw_id", "user": "author", "user_type": "author_type"})
        rc["source"] = "pr_review_comments"
        frames.append(rc.drop(columns=["repo_full_name", "number", "pull_request_url"]))

    cmt = pd.concat(frames, ignore_index=True)
    cmt["pr_id"] = pd.to_numeric(cmt["pr_id"], errors="coerce")
    dropped = int(cmt["pr_id"].isna().sum())
    info["comments_dropped_unresolved_pr"] = dropped
    cmt = cmt.dropna(subset=["pr_id"]).copy()
    cmt["pr_id"] = cmt["pr_id"].astype("int64")
    cmt["raw_id"] = cmt["raw_id"].astype("int64")
    cmt["author"] = clean_series(cmt["author"])
    cmt["body"] = clean_series(cmt["body"])
    cmt["author_type"] = clean_series(cmt["author_type"])
    cmt["created_at"] = pd.to_datetime(cmt["created_at"], utc=True, errors="coerce")
    cmt["author_is_bot"] = cmt["author_type"].str.lower().eq("bot") | cmt["author"].str.endswith("[bot]")
    # Comment ids are only unique inside their own table.
    cmt["comment_id"] = cmt["source"] + ":" + cmt["raw_id"].astype(str)
    info["comments_total"] = int(len(cmt))
    return cmt, info


# --------------------------------------------------------------------------- #
# stage 4: automatic identification (original auto_ident.py logic)
# --------------------------------------------------------------------------- #
def identify(prs: pd.DataFrame, cmt: pd.DataFrame) -> tuple[list[dict], dict, list[dict]]:
    by_repo_number: dict[tuple[int, int], int] = {}
    number_of: dict[int, int] = {}
    author_of: dict[int, str] = {}
    title_of: dict[int, str] = {}
    body_of: dict[int, str] = {}
    created_of: dict[int, pd.Timestamp] = {}
    closed_of: dict[int, pd.Timestamp] = {}
    repo_of: dict[int, int] = {}
    for r in prs.itertuples(index=False):
        pid = int(r.id)
        by_repo_number[(int(r.repo_id), int(r.number))] = pid
        number_of[pid] = int(r.number)
        author_of[pid] = r.user
        title_of[pid] = r.title
        body_of[pid] = r.body
        created_of[pid] = r.created_at
        closed_of[pid] = r.closed_at
        repo_of[pid] = int(r.repo_id)

    # F3.1 needs the earliest comment each author left on a given PR.
    first_comment_time: dict[tuple[int, str], pd.Timestamp] = {}
    for r in cmt.itertuples(index=False):
        if pd.isna(r.created_at):
            continue
        k = (int(r.pr_id), r.author)
        old = first_comment_time.get(k)
        if old is None or r.created_at < old:
            first_comment_time[k] = r.created_at

    counters: dict[str, int] = defaultdict(int)
    pair_evidence: dict[tuple[int, int], list[dict]] = defaultdict(list)
    unfiltered_evidence: dict[tuple[int, int], list[dict]] = defaultdict(list)
    unresolved: list[dict] = []
    max_number_by_repo = prs.groupby("repo_id")["number"].max().to_dict()

    ref = cmt[cmt["body"].str.contains(HAS_REF_RE, regex=True, na=False)]
    counters["comments_with_cross_pr_reference"] = int(len(ref))

    for r in ref.itertuples(index=False):
        src_id = int(r.pr_id)
        if src_id not in number_of:
            counters["comment_on_pr_outside_table"] += 1
            continue
        repo = repo_of[src_id]
        src_num = number_of[src_id]
        for tgt_num in extract_numbers(r.body):
            counters["rule_mentions"] += 1
            tgt_id = by_repo_number.get((repo, tgt_num))
            if tgt_id is None:
                # Published F1: the number is treated as an issue and dropped.
                counters["f1_unresolved_target"] += 1
                repo_max = int(max_number_by_repo.get(repo, 0))
                unresolved.append({
                    "source_pr_id": src_id,
                    "source_pr_number": src_num,
                    "repo_id": repo,
                    "target_number": tgt_num,
                    "target_above_repo_max_number": bool(tgt_num > repo_max),
                    "comment_id": r.comment_id,
                    "comment_source": r.source,
                    "comment_author": r.author,
                    "comment_created_at": r.created_at,
                    "comment_body": r.body[:500],
                })
                continue
            tgt_id = int(tgt_id)
            if tgt_id == src_id:
                counters["self_reference"] += 1
                continue
            counters["resolved_mentions"] += 1

            # Original code orders master/duplicate by PR *number*, not by time.
            dup_num, mst_num = max(src_num, tgt_num), min(src_num, tgt_num)
            dup_id = by_repo_number[(repo, dup_num)]
            mst_id = by_repo_number[(repo, mst_num)]

            rec = {
                "comment_id": r.comment_id,
                "comment_source": r.source,
                "comment_pr_id": src_id,
                "comment_author": r.author,
                "comment_author_is_bot": bool(r.author_is_bot),
                "comment_created_at": r.created_at,
                "matched_target_number": int(tgt_num),
                "comment_body": r.body,
            }
            unfiltered_evidence[(mst_id, dup_id)].append(rec)

            # F2
            if author_of[mst_id] == author_of[dup_id]:
                counters["f2_same_author"] += 1
                continue
            # F3.1
            prior = first_comment_time.get((mst_id, author_of[dup_id]))
            dup_created = created_of[dup_id]
            if prior is not None and pd.notna(dup_created) and prior < dup_created:
                counters["f3_1_prior_comment"] += 1
                continue
            # F3.2 - substring test, kept identical to auto_ident.py
            token = str(mst_num)
            if token in title_of[dup_id] or token in body_of[dup_id]:
                counters["f3_2_snapshot_reference"] += 1
                continue

            pair_evidence[(mst_id, dup_id)].append(rec)

    # How many reviewers/comments did the duplicate PR accumulate before detection?
    comments_by_pr: dict[int, list] = defaultdict(list)
    for r in cmt.itertuples(index=False):
        if pd.notna(r.created_at):
            comments_by_pr[int(r.pr_id)].append((r.created_at, r.author, r.author_is_bot))

    def effort(pr_id: int, until: pd.Timestamp) -> tuple[int, int, int]:
        rows = [x for x in comments_by_pr.get(pr_id, []) if pd.notna(until) and x[0] < until]
        return len(rows), len({a for _, a, _ in rows}), sum(1 for _, _, b in rows if b)

    rows_out: list[dict] = []
    for (mst_id, dup_id), ev in sorted(pair_evidence.items()):
        ev.sort(key=lambda x: (pd.isna(x["comment_created_at"]), x["comment_created_at"], x["comment_id"]))
        first = ev[0]
        idn_time = first["comment_created_at"]
        dup_created = created_of[dup_id]
        mst_created = created_of[mst_id]
        dup_closed = closed_of[dup_id]
        prior_c, prior_r, prior_bot = effort(dup_id, idn_time)
        latency_h = ((idn_time - dup_created).total_seconds() / 3600.0
                     if pd.notna(idn_time) and pd.notna(dup_created) else None)
        close_lag_h = ((dup_closed - idn_time).total_seconds() / 3600.0
                       if pd.notna(dup_closed) and pd.notna(idn_time) else None)
        rows_out.append({
            "repo_id": repo_of[mst_id],
            "master_pr_id": mst_id,
            "master_pr_number": number_of[mst_id],
            "duplicate_pr_id": dup_id,
            "duplicate_pr_number": number_of[dup_id],
            "master_title": title_of[mst_id],
            "duplicate_title": title_of[dup_id],
            "master_author": author_of[mst_id],
            "duplicate_author": author_of[dup_id],
            "master_agent": "",  # filled by caller if needed
            "duplicate_agent": "",
            "master_created_at": mst_created,
            "duplicate_created_at": dup_created,
            "idn_cmt_id": first["comment_id"],
            "idn_cmt_source": first["comment_source"],
            "idn_cmt_author": first["comment_author"],
            "idn_cmt_author_is_bot": first["comment_author_is_bot"],
            "idn_cmt_created_at": idn_time,
            "idn_cmt_body": first["comment_body"],
            "evidence_count": len(ev),
            "evidence_comment_ids": ";".join(x["comment_id"] for x in ev),
            "detection_latency_hours": latency_h,
            "duplicate_pr_comments_before_detection": prior_c,
            "duplicate_pr_reviewers_before_detection": prior_r,
            "duplicate_pr_bot_comments_before_detection": prior_bot,
            "duplicate_pr_closed_after_idn": bool(pd.notna(dup_closed) and pd.notna(idn_time) and dup_closed >= idn_time),
            "duplicate_pr_close_lag_hours": close_lag_h,
            "number_order_matches_time_order": bool(pd.notna(mst_created) and pd.notna(dup_created) and mst_created <= dup_created),
        })

    counters["candidate_pairs"] = len(rows_out)
    counters["unfiltered_unique_pairs"] = len(unfiltered_evidence)
    return rows_out, dict(counters), unresolved


# --------------------------------------------------------------------------- #
# stage 1 replay: random sampling of comments with a cross-PR reference
# --------------------------------------------------------------------------- #
def replay_sampling(prs: pd.DataFrame, cmt: pd.DataFrame, cap: int, seed: int) -> tuple[pd.DataFrame, dict]:
    ref = cmt[cmt["body"].str.contains(HAS_REF_RE, regex=True, na=False)].copy()
    ref = ref.merge(prs[["id", "repo_id", "repo_full_name"]].rename(columns={"id": "pr_id"}),
                    on="pr_id", how="left")
    rng = np.random.default_rng(seed)
    picks = []
    for _, grp in ref.groupby("repo_id", sort=False):
        if len(grp) > cap:
            grp = grp.iloc[rng.choice(len(grp), size=cap, replace=False)]
        picks.append(grp)
    sample = pd.concat(picks, ignore_index=True) if picks else ref.iloc[0:0]
    sample["rule_numbers"] = sample["body"].map(lambda b: ",".join(str(x) for x in extract_numbers(b)))
    sample["matched_by_rules"] = sample["rule_numbers"].str.len() > 0
    stats = {
        "comments_with_cross_pr_reference": int(len(ref)),
        "repos_with_at_least_one_reference_comment": int(ref["repo_id"].nunique()),
        "sampling_cap_per_repo": int(cap),
        "seed": int(seed),
        "sampled_comments": int(len(sample)),
        "sampled_matched_by_rules": int(sample["matched_by_rules"].sum()),
        "rule_hit_rate_percent": pct(int(sample["matched_by_rules"].sum()), len(sample)),
        "note": ("The paper sampled 200 comments per project and then manually separated "
                 "indicative from non-indicative comments. Rule hit-rate here is only the "
                 "share of sampled reference comments the published rules match; deciding "
                 "whether a match really states a duplicate relation still needs a human."),
    }
    return sample, stats


# --------------------------------------------------------------------------- #
# reporting
# --------------------------------------------------------------------------- #
def latency_summary(rows: list[dict]) -> dict:
    lat = np.array([r["detection_latency_hours"] for r in rows
                    if r["detection_latency_hours"] is not None], dtype=float)
    if lat.size == 0:
        return {"n": 0}
    return {
        "n": int(lat.size),
        "median_hours": round(float(np.median(lat)), 2),
        "mean_hours": round(float(lat.mean()), 2),
        "p90_hours": round(float(np.percentile(lat, 90)), 2),
        "max_hours": round(float(lat.max()), 2),
        "over_1_day": int((lat > 24).sum()),
        "over_1_week": int((lat > 24 * 7).sum()),
        "over_1_week_percent": pct(int((lat > 24 * 7).sum()), int(lat.size)),
    }


def effort_summary(rows: list[dict]) -> dict:
    if not rows:
        return {"n": 0}
    c = np.array([r["duplicate_pr_comments_before_detection"] for r in rows], dtype=float)
    rv = np.array([r["duplicate_pr_reviewers_before_detection"] for r in rows], dtype=float)
    return {
        "n": len(rows),
        "mean_comments_before_detection": round(float(c.mean()), 2),
        "median_comments_before_detection": round(float(np.median(c)), 2),
        "mean_reviewers_before_detection": round(float(rv.mean()), 2),
        "median_reviewers_before_detection": round(float(np.median(rv)), 2),
        "sum_comments_before_detection": int(c.sum()),
    }


